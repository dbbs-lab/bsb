{
  "installation": {
    "version": "23.1.2",
    "plugins": {
      "@nxlv/python": "npm:@helveg/nx-python@23.0.1"
    }
  },
  "plugins": [
    {
      "plugin": "@nxlv/python",
      "options": {
        "packageManager": "uv"
      }
    }
  ],
  "release": {
    "projects": [
      "packages/*",
      "libs/*"
    ],
    "changelog": {
      "projectChangelogs": true,
      "workspaceChangelog": {
        "createRelease": "github",
        "file": "CHANGELOG.md"
      },
      "git": {
        "commit": true,
        "tag": true,
        "commitMessage": "chore(release): {version}"
      }
    },
    "version": {
      "conventionalCommits": true,
      "versionActions": "@nxlv/python/release/version-actions"
    }
  },
  "generators": {
    "@nxlv/python:uv-project": {
      "projectType": "library",
      "pyprojectPythonDependency": ">=3.9,<3.12",
      "pyenvPythonVersion": "3.10.12",
      "publishable": true,
      "buildBundleLocalDependencies": false,
      "buildLockedVersions": false,
      "linter": "ruff",
      "unitTestRunner": "pytest",
      "codeCoverage": true
    }
  },
  "$schema": "./.nx/installation/node_modules/nx/schemas/project-schema.json"
}
